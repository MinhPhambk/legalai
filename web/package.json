{
  "name": "nd45-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Giao diện web chat cho agent pháp lý ND4–ND5 (opencode)",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "vite build client && node scripts/prerender.mjs && node scripts/precompress.mjs",
    "start": "node --disable-warning=ExperimentalWarning server/index.mjs",
    "dev": "node scripts/dev.mjs",
    "create-user": "node --disable-warning=ExperimentalWarning scripts/create-user.mjs",
    "brand:build": "node scripts/brand-build.mjs"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "express": "^5.2.1",
    "jszip": "^3.10.2",
    "mammoth": "^1.12.3",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "docx": "^9.7.2",
    "dompurify": "^3.4.16",
    "ffmpeg-static": "^5.3.0",
    "marked": "^18.0.14",
    "mermaid": "12.0.0",
    "opentype.js": "^2.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.1"
  }
